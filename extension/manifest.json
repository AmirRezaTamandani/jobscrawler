{
  "manifest_version": 3,
  "name": "Felowin applications",
  "version": "1.0.0",
  "description": "Review and send selected applications with your signed-in Jobinja and JobVision sessions.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://jobinja.ir/*",
    "https://jobvision.ir/*"
  ],
  "action": {
    "default_title": "Felowin applications",
    "default_popup": "popup.html"
  }
}
