{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/dashboard.py": { "includeFiles": "jobscrawler/**" },
    "api/cron.py": { "includeFiles": "jobscrawler/**", "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "30 4 * * *" }
  ]
}
